# Local Docker (see docker-compose.yml)
MONGODB_URI=mongodb://127.0.0.1:27017/doc_find_demo?replicaSet=rs0&directConnection=true
MONGODB_DB=doc_find_demo
PROTOTYPE_COOKIE_SECRET=replace-with-a-long-local-random-value
DEMO_MODE=true

# Vercel: Project Settings → Environment Variables
# Required in Production: PROTOTYPE_COOKIE_SECRET (long random string)
# Recommended: MONGODB_URI (MongoDB Atlas replica set; workflow commands need transactions)
# MONGODB_DB and DEMO_MODE default via vercel.json; override only if needed
